{
    "$schema": "https://docs.renovatebot.com/renovate-schema.json",
    "extends": [
        "config:recommended",
        ":dependencyDashboard"
    ],
    "rebaseWhen": "never",
    "assignees": [
        "bloodbare",
        "ciniesta",
        "vangheem",
        "carlesonielfa"
    ],
    "pip_setup": {
        "enabled": false
    },
    "pip_requirements": {
        "enabled": false
    },
    "pipenv": {
        "enabled": false
    },
    "poetry": {
        "enabled": false
    },
    "pep621": {
        "enabled": false
    },
    "cargo": {
        "enabled": false
    },
    "ignorePaths": [
        ".github/workflows/blackduck-sca.yaml",
        ".github/workflows/polaris.yaml",
        ".github/workflows/wf-dispatch-bd-sca-dispatch.yaml"
    ],
    "packageRules": [
        {
            "matchPackageNames": ["python"],
            "matchCurrentVersion": "3.10.19",
            "allowedVersions": "<3.11"
        },
        {
            "matchDepTypes": [
                "action"
            ],
            "pinDigests": true
        }
    ]
}
